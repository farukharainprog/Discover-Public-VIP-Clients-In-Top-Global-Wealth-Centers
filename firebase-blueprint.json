{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Public business lead discovered and managed by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "businessName": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 300 },
        "email": { "type": "string", "maxLength": 200 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 50 },
        "facebook": { "type": "string", "maxLength": 300 },
        "instagram": { "type": "string", "maxLength": 300 },
        "linkedin": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "source": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["new", "contacted", "interested", "not_interested", "client"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "isVerified": { "type": "boolean" },
        "companySize": { "type": "string", "maxLength": 50 },
        "verificationDetails": { "type": "string", "maxLength": 500 },
        "lastVerifiedDate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "businessName", "country", "industry", "status", "createdAt"]
    },
    "PrivateWhatsAppLead": {
      "title": "PrivateWhatsAppLead",
      "description": "Owner-only private WhatsApp verified business or creator contact",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "businessOrCreatorName": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 100 },
        "city": { "type": "string", "maxLength": 100 },
        "categoryType": { "type": "string", "maxLength": 50 },
        "subCategory": { "type": "string", "maxLength": 100 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 50 },
        "website": { "type": "string", "maxLength": 300 },
        "email": { "type": "string", "maxLength": 200 },
        "instagram": { "type": "string", "maxLength": 300 },
        "youtube": { "type": "string", "maxLength": 300 },
        "tiktok": { "type": "string", "maxLength": 300 },
        "facebook": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "source": { "type": "string", "maxLength": 300 },
        "verificationStatus": { "type": "string", "maxLength": 100 },
        "verificationDetails": { "type": "string", "maxLength": 500 },
        "lastVerifiedDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["new", "contacted", "interested", "client", "not_interested"] },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["ownerEmail", "businessOrCreatorName", "country", "status", "createdAt"]
    },
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Approved Gmail accounts managed by the Super Owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_owner", "invited_member", "trusted_family"] },
        "status": { "type": "string", "enum": ["approved", "pending", "suspended", "revoked"] },
        "label": { "type": "string", "maxLength": 100 },
        "addedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role", "status", "addedAt"]
    },
    "SearchHistoryItem": {
      "title": "SearchHistoryItem",
      "description": "Owner search activity history record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "query": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 100 },
        "resultsFound": { "type": "number" },
        "performedAt": { "type": "string" },
        "userEmail": { "type": "string", "maxLength": 200 }
      },
      "required": ["query", "performedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with VIP status and quotas",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "vip", "member"] },
        "savedLeadsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Global VIP system configurations controlled by administrator",
      "type": "object",
      "properties": {
        "searchEnabled": { "type": "boolean" },
        "exportCsvEnabled": { "type": "boolean" },
        "exportExcelEnabled": { "type": "boolean" },
        "aiOutreachEnabled": { "type": "boolean" },
        "maxLeadsPerSearch": { "type": "number" },
        "vipAnnouncement": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["searchEnabled", "exportCsvEnabled", "exportExcelEnabled", "aiOutreachEnabled"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Saved leads belonging to specific users"
    },
    "/private_whatsapp_leads/{leadId}": {
      "schema": { "$ref": "#/entities/PrivateWhatsAppLead" },
      "description": "Exclusively private owner leads for Farukh Businessman Wala"
    },
    "/authorized_users/{userDocId}": {
      "schema": { "$ref": "#/entities/AuthorizedUser" },
      "description": "Owner-managed Gmail access whitelist"
    },
    "/search_history/{historyId}": {
      "schema": { "$ref": "#/entities/SearchHistoryItem" },
      "description": "Global search audit history logs"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profiles for registered VIP users"
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "System-wide settings accessible by Admin and readable by members"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Admin authorization markers"
    }
  }
}
